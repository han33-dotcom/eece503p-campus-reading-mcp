                "subjects"
              ],
              "type": "object"
            },
            "saved_at": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "list_name",
            "book",
            "saved_at"
          ],
          "type": "object"
        }
      },
      "required": [
        "query",
